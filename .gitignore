# --- THIRD-PARTY material: needed to run the benches locally,
#     NOT part of the release, it must never reach a public repo ---
sim/*.bin
sim/rom/
sim/rtl/
sim/oracle/*-ext/
sim/oracle/golden/
sim/darius_ref/
reference/

