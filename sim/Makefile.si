	$(VERILATOR) $(VFLAGS) +incdir+$(RTL)/cpu_si \
	  --top-module m68k_cpu_si -GDBG=1 -GMEM_FILE='"$(RTL)/cpu_si/m68k_urom.mem"' -GORIGIN_FILE='"$(RTL)/cpu_si/m68k_norigin.mem"' -GNANO_FILE='"$(RTL)/cpu_si/m68k_nrom.mem"' -GNANO_M_FILE='"$(RTL)/cpu_si/m68k_nrom_m.mem"' \
	  $(SI_PKGS) $(RTL)/cpu_si/m68k_cpu_si.sv $(RTL)/cpu_si/m68k_nstore_dec.sv $(RTL)/cpu_si/m68k_nano_dec.sv $(RTL)/cpu_si/m68k_ustore.sv $(RTL)/cpu_si/m68k_urom.sv $(RTL)/cpu_si/m68k_useq.sv $(RTL)/cpu_si/m68k_nrom.sv $(RTL)/cpu_si/m68k_bus_sec.sv $(RTL)/cpu_si/m68k_regs_bd.sv $(RTL)/cpu_si/m68k_au.sv $(RTL)/cpu_si/m68k_mvm_si.sv $(RTL)/cpu_si/m68k_regfile_si.sv $(RTL)/cpu_si/m68k_alux_si.sv $(RTL)/cpu_si/m68k_alu_si.sv $(RTL)/cpu_si/m68k_alu_rowdec.sv $(RTL)/cpu_si/m68k_size_si.sv $(RTL)/cpu_si/m68k_exc_si.sv $(RTL)/cpu_si/m68k_ftu_si.sv $(RTL)/cpu_si/m68k_psw_si.sv $(RTL)/cpu_si/m68k_ir_si.sv $(RTL)/cpu_si/m68k_a123_si.sv $(RTL)/cpu_si/m68k_branch_si.sv $(RTL)/cpu_si/m68k_busctl_si.sv $(RTL)/cpu_si/m68k_bus_fsm.sv \
	  tb_m68k_cpu_si.cpp \
	  -o Vm68k_cpu_si

# ---------------------------------------------------------------------------
# make -f Makefile.si test
#   Runs the block benches: each block of the core is compared against an
#   independently written model, exhaustively wherever the input space allows
#   it. Prints a summary. Needs nothing but Verilator.
# ---------------------------------------------------------------------------
BLOCKS := ustore nstore ndec bussec regs regfile_si rowdec alu_si alux_si branch_si a123_si size_si cpu_si

.PHONY: test
test:
	@ok=0; ko=0; \
	for t in $(BLOCKS); do \
	  if out=$$($(MAKE) -s -f Makefile.si $$t 2>&1) && echo "$$out" | grep -q 'RESULT: PASS' \
	     && ! echo "$$out" | grep -q 'RESULT: FAIL'; then \
	    echo "  PASS  $$t"; ok=$$((ok+1)); \
	  else echo "  FAIL  $$t"; ko=$$((ko+1)); fi; \
	done; \
	echo ""; echo "$$ok PASS, $$ko FAIL"; \
	[ $$ko -eq 0 ]
