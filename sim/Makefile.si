# Makefile for the Verilator simulation flow.
#
# It must be run in the MSYS2 mingw64 environment (where verilator + g++ live).
# Launch it from an MSYS2 MINGW64 shell, in sim/:
#   make -f Makefile.si <target>
#
# Targets:
#   make clean   -> removes the artifacts
#
# Convention: every new module will have a similar target (testbench + RTL).

VERILATOR ?= verilator
BUILD     := build_si
RTL       := ../rtl
# DATA: raw data (transcriptions of the die and of the patent in docs/data) read at run time by the independent
# models of the block testbenches (+data=<file>); can be overridden from the command line.
DATA      ?= ../docs/data
# Corrections to the raw data, one file per block in docs/data/deviations: each entry has the printed value, the one used
# by the RTL and the source. To compare a block with the literal data, empty its variable (e.g. DEV_ROWDEC=).
DEVDIR     ?= ../docs/data/deviations
ADD_USTORE ?= $(DEVDIR)/ustore.tsv
DEV_NSTORE ?= $(DEVDIR)/nstore.tsv
DEV_BUSSEC ?= $(DEVDIR)/bussec.tsv
DEV_ROWDEC ?= $(DEVDIR)/rowdec.tsv
DEV_ALU    ?= $(DEVDIR)/alu.tsv
DEV_BRANCH ?= $(DEVDIR)/branch.tsv
DEV_A123   ?= $(DEVDIR)/a123.tsv
# ORGLUT: configuration of the control store in the testbenches that include it (0 = as in the core, 1 = a0s override everywhere, testbenches only).
ORGLUT    ?= 0
# EXTCLS: 1 = row class external to the A1/A2/A3 decoder (core, m68k_a123_top with m68k_a123_cls); 0 = internal combinational form
EXTCLS    ?= 1
# Makefile.si - the testbenches of the core (rtl/cpu_si); the per-instruction testbenches use it inside the shim
# m68k_seq_si.sv (m68k_seq module: the port interface of the instruction testbenches). Usage: make -f Makefile.si <target>
SI_PKGS := $(RTL)/cpu_si/m68k_nano_pkg.sv $(RTL)/cpu_si/m68k_nano_dec_pkg.sv $(RTL)/cpu_si/m68k_alu_pkg.sv $(RTL)/cpu_si/m68k_branch_pkg.sv
SI_SRC  := $(RTL)/cpu_si/m68k_cpu_si.sv $(RTL)/cpu_si/m68k_nstore_dec.sv $(RTL)/cpu_si/m68k_nano_dec.sv $(RTL)/cpu_si/m68k_ustore.sv \
	  $(RTL)/cpu_si/m68k_urom.sv $(RTL)/cpu_si/m68k_useq.sv $(RTL)/cpu_si/m68k_nrom.sv $(RTL)/cpu_si/m68k_bus_sec.sv \
	  $(RTL)/cpu_si/m68k_regs_bd.sv $(RTL)/cpu_si/m68k_au.sv $(RTL)/cpu_si/m68k_mvm_si.sv $(RTL)/cpu_si/m68k_regfile_si.sv \
	  $(RTL)/cpu_si/m68k_alux_si.sv $(RTL)/cpu_si/m68k_alu_si.sv $(RTL)/cpu_si/m68k_alu_rowdec.sv $(RTL)/cpu_si/m68k_size_si.sv \
	  $(RTL)/cpu_si/m68k_exc_si.sv $(RTL)/cpu_si/m68k_ftu_si.sv $(RTL)/cpu_si/m68k_psw_si.sv $(RTL)/cpu_si/m68k_ir_si.sv \
	  $(RTL)/cpu_si/m68k_a123_si.sv $(RTL)/cpu_si/m68k_branch_si.sv $(RTL)/cpu_si/m68k_busctl_si.sv $(RTL)/cpu_si/m68k_bus_fsm.sv

# Common flags: SystemVerilog, C++ build, VCD trace, useful warnings.
# -LDFLAGS static*: on this MSYS2 installation dynamic linking of
#   libstdc++/libgcc gives an ABI mismatch; static linking solves it.
# -CFLAGS -std=c++17: testbench standard. -I$(RTL)/../sim: the sim/ folder of the same tree as the RTL under test.
VFLAGS := --cc --exe --build --trace --x-assign 0 \
          -Wall -Wno-fatal \
          -CFLAGS "-std=c++17 -I$(abspath $(RTL)/../sim)" \
          -LDFLAGS "-static -static-libgcc -static-libstdc++" \
          --Mdir $(BUILD)

.PHONY: cpu_si size_si alux_si a123_si branch_si rowdec alu_si regfile_si regs bussec ndec ustore nstore all busfsm cpudt eorbw seq jmpjsr jsrext addi size mem ea ea2 alumem alumem2 aluidx rmw rmwcontam exc illegal priv trapv irq irqmulti muldiv muldivmem div0 movem movemx bitops bitext dbcc lea pea peacontam idx pcrel pea2 muls extswap addx movesr srlogic mvtsr stop tst link linka7 abcd chk chkneg usp adda addai clrmem negmem sccmem addxmem abcdmem movep sopbyte sopinc sopext subq roxl rtr shiftbw shiftmem addqea sccea movepd movean moveimm movepcr movem2m moveimm2m movean2m movem2mext aluinc alurmw aluext rstvec halt berr moveaidx braw clean run

all: busfsm cpudt eorbw seq jmpjsr jsrext addi size mem ea ea2 alumem alumem2 aluidx rmw rmwcontam exc illegal priv trapv irq irqmulti muldiv muldivmem div0 movem movemx bitops bitext dbcc lea pea peacontam idx pcrel pea2 muls extswap addx movesr srlogic mvtsr stop tst link linka7 abcd chk chkneg usp adda addai clrmem negmem sccmem addxmem abcdmem movep sopbyte sopinc sopext subq roxl rtr shiftbw shiftmem addqea sccea movepd movean moveimm movepcr movem2m moveimm2m movean2m movem2mext aluinc alurmw aluext rstvec halt berr moveaidx braw

# run: re-runs ONLY the binaries already compiled (no recompilation).
# Very fast: use it to re-verify the suite when you have not changed the RTL,
# or after a 'make all'/single target that has already recompiled what is needed.
# NB: do NOT run 'make clean' before 'make all' if you want incremental builds —
# make by itself recompiles only the targets whose .sv/.cpp have changed.
run:
	@for b in Vm68k_bus_fsm \
	          Vm68k_seq \
	          Vm68k_jmpjsr Vm68k_addi Vm68k_size Vm68k_mem Vm68k_ea Vm68k_ea2 \
	          Vm68k_alumem Vm68k_alumem2 Vm68k_rmw Vm68k_rmwcontam Vm68k_exc \
	          Vm68k_illegal Vm68k_priv Vm68k_trapv Vm68k_irq Vm68k_irqmulti \
	          Vm68k_muldiv Vm68k_div0 Vm68k_movem Vm68k_movemx Vm68k_bitops \
	          Vm68k_dbcc Vm68k_lea Vm68k_pea Vm68k_peacontam Vm68k_idx Vm68k_pcrel \
	          Vm68k_pea2 Vm68k_muls Vm68k_extswap Vm68k_addx Vm68k_movesr \
	          Vm68k_srlogic Vm68k_stop Vm68k_tst Vm68k_link Vm68k_linka7 \
	          Vm68k_abcd Vm68k_chk Vm68k_chkneg Vm68k_usp Vm68k_adda Vm68k_addai \
	          Vm68k_clrmem Vm68k_negmem Vm68k_sccmem Vm68k_addxmem Vm68k_abcdmem \
	          Vm68k_movep Vm68k_sopbyte Vm68k_sopinc Vm68k_sopext; do \
	  if [ -x $(BUILD)/$$b ]; then ./$(BUILD)/$$b | grep -E "PASS|FAIL"; \
	  else echo "(missing $$b: build it with 'make all')"; fi; \
	done

# --- 68000 bus cycle FSM ---
busfsm: $(BUILD)/Vm68k_bus_fsm
	@echo "=== running m68k_bus_fsm ==="
	./$(BUILD)/Vm68k_bus_fsm

$(BUILD)/Vm68k_bus_fsm: $(RTL)/cpu_si/m68k_bus_fsm.sv tb_m68k_bus_fsm.cpp
	$(VERILATOR) $(VFLAGS) \
	  --top-module m68k_bus_fsm \
	  $(RTL)/cpu_si/m68k_bus_fsm.sv \
	  tb_m68k_bus_fsm.cpp \
	  -o Vm68k_bus_fsm

# --- EOR.B/.W/.L Dn,Dn ---
eorbw: $(BUILD)/Vm68k_eorbw
	@echo "=== running m68k_eorbw ==="
	./$(BUILD)/Vm68k_eorbw

$(BUILD)/Vm68k_eorbw: m68k_seq_si.sv $(SI_PKGS) $(SI_SRC)  \
                      \
                       tb_m68k_eorbw.cpp
	$(VERILATOR) $(VFLAGS) \
	  --top-module m68k_seq -GMEM_FILE='"$(RTL)/cpu_si/m68k_urom.mem"' -GORIGIN_FILE='"$(RTL)/cpu_si/m68k_norigin.mem"' -GNANO_FILE='"$(RTL)/cpu_si/m68k_nrom.mem"' -GNANO_M_FILE='"$(RTL)/cpu_si/m68k_nrom_m.mem"' \
	  m68k_seq_si.sv $(SI_PKGS) $(SI_SRC) \
	   \
	   \
	   \
	   \
	    \
	  tb_m68k_eorbw.cpp \
	  -o Vm68k_eorbw

# --- 68000 microcycle sequencer (uses all CPU modules) ---
seq: $(BUILD)/Vm68k_seq
	@echo "=== running m68k_seq ==="
	./$(BUILD)/Vm68k_seq

$(BUILD)/Vm68k_seq: m68k_seq_si.sv $(SI_PKGS) $(SI_SRC)  \
                      \
                       tb_m68k_seq.cpp
	$(VERILATOR) $(VFLAGS) \
	  --top-module m68k_seq -GMEM_FILE='"$(RTL)/cpu_si/m68k_urom.mem"' -GORIGIN_FILE='"$(RTL)/cpu_si/m68k_norigin.mem"' -GNANO_FILE='"$(RTL)/cpu_si/m68k_nrom.mem"' -GNANO_M_FILE='"$(RTL)/cpu_si/m68k_nrom_m.mem"' -GSINGLE_CEN=1 \
	  m68k_seq_si.sv $(SI_PKGS) $(SI_SRC) \
	   \
	   \
	   \
	   \
	    \
	  tb_m68k_seq.cpp \
	  -o Vm68k_seq

