# --- Silicon core: micro control store (rtl/cpu_si) ---
ustore: $(BUILD)/Vm68k_ustore
	@echo "=== running m68k_ustore ==="
	./$(BUILD)/Vm68k_ustore +data=$(DATA)/mc68000_micro_decoded.csv $(if $(ADD_USTORE),+add=$(ADD_USTORE))

$(BUILD)/Vm68k_ustore: $(RTL)/cpu_si/m68k_ustore.sv $(RTL)/cpu_si/m68k_urom.sv $(RTL)/cpu_si/m68k_useq.sv $(RTL)/cpu_si/m68k_nrom.sv $(RTL)/cpu_si/m68k_nano_pkg.sv $(RTL)/cpu_si/m68k_urom.mem $(RTL)/cpu_si/m68k_nrom.mem $(RTL)/cpu_si/m68k_norigin.mem tb_m68k_ustore.cpp $(DATA)/mc68000_micro_decoded.csv
	$(VERILATOR) $(VFLAGS) +incdir+$(RTL)/cpu_si \
	  --top-module m68k_ustore -GORG_OVR_LUT=0 -GMEM_FILE='"$(RTL)/cpu_si/m68k_urom.mem"' -GORIGIN_FILE='"$(RTL)/cpu_si/m68k_norigin.mem"' -GNANO_FILE='"$(RTL)/cpu_si/m68k_nrom.mem"' -GNANO_M_FILE='"$(RTL)/cpu_si/m68k_nrom_m.mem"' \
	  $(SI_PKGS) $(RTL)/cpu_si/m68k_ustore.sv $(RTL)/cpu_si/m68k_urom.sv $(RTL)/cpu_si/m68k_useq.sv $(RTL)/cpu_si/m68k_nrom.sv \
	  tb_m68k_ustore.cpp \
	  -o Vm68k_ustore

# --- Silicon core: nano ROM with our own encoding + ORIGIN (rtl/cpu_si) ---
nstore: $(BUILD)/Vm68k_nstore
	@echo "=== running m68k_nstore ==="
	./$(BUILD)/Vm68k_nstore +apph=$(DATA)/us4325121_appH.tsv +diemap=$(DATA)/us4325121_appH_die_map.tsv $(if $(DEV_NSTORE),+dev=$(DEV_NSTORE)) +lut=$(ORGLUT)

$(BUILD)/Vm68k_nstore: $(RTL)/cpu_si/m68k_ustore.sv $(RTL)/cpu_si/m68k_urom.sv $(RTL)/cpu_si/m68k_useq.sv $(RTL)/cpu_si/m68k_nrom.sv $(RTL)/cpu_si/m68k_nano_pkg.sv $(RTL)/cpu_si/m68k_urom.mem $(RTL)/cpu_si/m68k_nrom.mem $(RTL)/cpu_si/m68k_norigin.mem tb_m68k_nstore.cpp m68k_apph_model.h
	$(VERILATOR) $(VFLAGS) +incdir+$(RTL)/cpu_si --prefix Vm68k_ustore \
	  --top-module m68k_ustore -GORG_OVR_LUT=$(ORGLUT) -GMEM_FILE='"$(RTL)/cpu_si/m68k_urom.mem"' -GORIGIN_FILE='"$(RTL)/cpu_si/m68k_norigin.mem"' -GNANO_FILE='"$(RTL)/cpu_si/m68k_nrom.mem"' -GNANO_M_FILE='"$(RTL)/cpu_si/m68k_nrom_m.mem"' \
	  $(SI_PKGS) $(RTL)/cpu_si/m68k_ustore.sv $(RTL)/cpu_si/m68k_urom.sv $(RTL)/cpu_si/m68k_useq.sv $(RTL)/cpu_si/m68k_nrom.sv \
	  tb_m68k_nstore.cpp \
	  -o Vm68k_nstore

