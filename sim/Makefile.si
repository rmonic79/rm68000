$(BUILD)/Vm68k_nstore_dec: $(RTL)/cpu_si/m68k_nstore_dec.sv $(RTL)/cpu_si/m68k_nano_dec.sv $(RTL)/cpu_si/m68k_ustore.sv $(RTL)/cpu_si/m68k_urom.sv $(RTL)/cpu_si/m68k_useq.sv $(RTL)/cpu_si/m68k_nrom.sv $(RTL)/cpu_si/m68k_nano_pkg.sv $(RTL)/cpu_si/m68k_nano_dec_pkg.sv $(RTL)/cpu_si/m68k_urom.mem $(RTL)/cpu_si/m68k_nrom.mem $(RTL)/cpu_si/m68k_norigin.mem tb_m68k_ndec.cpp m68k_ndec_fields.h m68k_apph_model.h
	$(VERILATOR) $(VFLAGS) +incdir+$(RTL)/cpu_si \
	  --top-module m68k_nstore_dec -GORG_OVR_LUT=$(ORGLUT) -GMEM_FILE='"$(RTL)/cpu_si/m68k_urom.mem"' -GORIGIN_FILE='"$(RTL)/cpu_si/m68k_norigin.mem"' -GNANO_FILE='"$(RTL)/cpu_si/m68k_nrom.mem"' -GNANO_M_FILE='"$(RTL)/cpu_si/m68k_nrom_m.mem"' \
