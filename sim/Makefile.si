	$(VERILATOR) $(VFLAGS) +incdir+$(RTL)/cpu_si \
	  --top-module m68k_bus_top -GORG_OVR_LUT=$(ORGLUT) -GMEM_FILE='"$(RTL)/cpu_si/m68k_urom.mem"' -GORIGIN_FILE='"$(RTL)/cpu_si/m68k_norigin.mem"' -GNANO_FILE='"$(RTL)/cpu_si/m68k_nrom.mem"' -GNANO_M_FILE='"$(RTL)/cpu_si/m68k_nrom_m.mem"' \
